VITE_API_URL=http://localhost:3001

# mock uses the local sample data. http calls /api/integrations on the UnitTrip server.
# Do not put API keys or secrets in this file. Those belong in unitrip-server/.env.
VITE_FLIGHT_PROVIDER=mock
VITE_HOTEL_PROVIDER=mock
VITE_TRAIN_PROVIDER=mock
VITE_PACKAGE_PROVIDER=mock
VITE_PAYMENT_PROVIDER=mock
VITE_NOTIFICATION_PROVIDER=mock
